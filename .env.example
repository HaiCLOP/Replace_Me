# Copy to .env and fill in. .env is git-ignored.

# ── Reply model (Anthropic Messages API) ─────────────────────────────────────
# Your own key from console.anthropic.com. ANTHROPIC_BASE_URL only if you use an Anthropic-compatible gateway
# (a third-party gateway can read everything you send: see docs/PRIVACY.md).
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Model chain, tried left to right. "@effort" turns on real thinking at that depth (low|medium|high).
# ollama:<name> = a model on your own PC (e.g. your fine-tuned one, docs/FINE_TUNING.md).
LLM_CHAIN=anthropic:claude-opus-5-5@medium,anthropic:claude-sonnet-5-5
# Model that writes your notes on each person and your master profile (reads whole chats once).
RESEARCH_MODEL=anthropic:claude-opus-5-5@medium
# Best-of-N picker and blind judge.
PICKER_CHAIN=anthropic:claude-opus-5-5@low
JUDGE_CHAIN=anthropic:claude-opus-5-5@low

# ── Reply pipeline (defaults = the best measured setup, see docs/EVALUATION.md) ─
CANDIDATES=4               # replies written per turn; the picker chooses one
PICKER=judge               # judge = blind-judge-style picker held to your real reply lengths; "" = take the first
USE_TOOLS=true             # cached prompt + lookup tools (chats, dates, gossip) instead of one huge prompt
MASK_NAMES=true            # names/handles become codes in everything sent to a cloud model
GOSSIP_MIN_SCORE=90        # only people you score 90+ (me/profile.yaml) hear about other chats
VOICE=                     # "" = the cloud model writes; meaning_all = option C (your fine-tuned model words it)
VOICE_MODEL=ollama:my-voice

# ── Instagram ────────────────────────────────────────────────────────────────
INBOX_SCAN_SECONDS=5       # how often the inbox list is read
INBOX_MAX_PARALLEL=3       # chats answered at the same time (one tab each)
INBOX_HOT_SECONDS=120      # after a reply, keep that chat open this long...
INBOX_HOT_POLL_SECONDS=5   # ...and re-read it this often
HUMAN_TIMING=true          # human-like reading pause and typing speed
IGNORE_HANDLES=            # comma-separated usernames never answered

# Ollama (only for VOICE / ollama: models)
OLLAMA_BASE_URL=http://127.0.0.1:11434
